{
  "$defs": {
    "AmountOrScalar": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money",
          "description": "Currency-aware amount"
        },
        {
          "description": "Unitless scalar (ratio, percentage, count, etc.)",
          "format": "double",
          "type": "number"
        }
      ],
      "description": "Value that can be currency-aware or unitless.\n\nUsed for node values that can represent:\n- **Amount**: Currency-aware monetary values (e.g., USD 1,000,000)\n- **Scalar**: Unitless values (e.g., ratios, percentages, counts)"
    },
    "CapitalStructureSpec": {
      "additionalProperties": false,
      "description": "Capital structure specification.",
      "properties": {
        "debt_instruments": {
          "description": "Debt instruments (bonds, loans, swaps)",
          "items": {
            "$ref": "#/$defs/DebtInstrumentSpec"
          },
          "type": "array"
        },
        "equity_instruments": {
          "description": "Reserved equity instruments payloads.\n\nThe field is currently not consumed by the waterfall engine. It is kept\nas a serde-compatible extension point for callers already persisting\ncapital-structure JSON with equity-side metadata.",
          "items": true,
          "type": "array"
        },
        "fx_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/FxConversionPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional FX conversion policy override (defaults to CashflowDate)"
        },
        "meta": {
          "additionalProperties": true,
          "description": "Additional metadata",
          "type": "object"
        },
        "reporting_currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional reporting currency override for capital structure totals"
        },
        "waterfall": {
          "anyOf": [
            {
              "$ref": "#/$defs/WaterfallSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional waterfall specification for dynamic cash flow allocation"
        }
      },
      "type": "object"
    },
