    "DebtInstrumentSpec": {
      "additionalProperties": false,
      "description": "Debt instrument specification.\n\nAn identifier paired with a canonical tagged instrument payload. With the\ndefault `valuation-integration` feature, the `spec` value is resolved through\nthe valuations instrument registry from the tagged form\n`{\"type\": \"<tag>\", \"spec\": {...}}`.",
      "properties": {
        "id": {
          "description": "Instrument identifier (key within the capital structure).",
          "type": "string"
        },
        "spec": {
          "$ref": "https://finstack_quant.dev/schemas/instrument/1/instrument.schema.json#/$defs/InstrumentJson",
          "description": "Canonical tagged instrument payload: `{\"type\": \"...\", \"spec\": {...}}`."
        }
      },
      "required": [
        "id",
        "spec"
      ],
      "type": "object"
    },
    "EcfSweepSpec": {
      "additionalProperties": false,
      "description": "Excess Cash Flow (ECF) sweep specification.\n\nDefines how to calculate ECF and what percentage to sweep to pay down debt.\n\n# ECF Calculation\n\nThe standard ECF formula deducts cash interest from EBITDA. Fees and\nscheduled principal are also deducted when those payment categories rank\nahead of the prepayment priority:\n\n```text\nECF = EBITDA - Taxes - CapEx - ΔWC - Cash Interest Paid\n      - Fees Paid Ahead of Prepayment\n      - Scheduled Principal Paid Ahead of Prepayment\n```\n\nSet `cash_interest_node` to override the cash-interest input. If omitted,\ncontractual cash interest is deducted automatically using the period's\ndebt-service magnitude.\n\n# References\n\n- Fixed-income and leverage context: `docs/REFERENCES.md#tuckman-serrat-fixed-income`",
      "properties": {
        "capex_node": {
          "description": "Formula or node reference for capital expenditures (e.g., \"capex\")",
          "type": [
            "string",
            "null"
          ]
        },
        "cash_interest_node": {
          "description": "Formula or node reference for cash interest paid (e.g., \"cs.interest_expense_cash.total\").\n\nPer S&P LCD / standard LPA definitions, ECF should deduct cash interest paid.\nIf omitted, contractual cash interest is deducted automatically.",
          "type": [
            "string",
            "null"
          ]
        },
        "ebitda_node": {
          "description": "Formula or node reference for EBITDA (e.g., \"ebitda\" or \"revenue - cogs - opex\")",
          "type": "string"
        },
        "sweep_percentage": {
          "description": "Sweep percentage (e.g., 0.5 for 50%, 0.75 for 75%)",
          "format": "double",
          "type": "number"
        },
        "target_instrument_id": {
          "description": "Target instrument ID for sweep payments (if None, applies to all term loans)",
          "type": [
            "string",
            "null"
          ]
        },
        "taxes_node": {
          "description": "Formula or node reference for taxes (e.g., \"taxes\")",
          "type": [
            "string",
            "null"
          ]
        },
        "working_capital_node": {
          "description": "Formula or node reference for working capital change (e.g., \"wc_change\")",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ebitda_node",
        "sweep_percentage"
      ],
      "type": "object"
    },
    "ForecastMethod": {
      "description": "Available forecast methods.",
      "oneOf": [
        {
          "const": "forward_fill",
          "description": "Carry last value forward",
          "type": "string"
        },
        {
          "const": "growth_pct",
          "description": "Compound growth: `v[t] = v[t-1] * (1 + rate)`",
          "type": "string"
        },
        {
          "const": "curve_pct",
          "description": "Period-specific growth rates: `v[t] = v[t-1] * (1 + curve[t])`",
          "type": "string"
        },
        {
          "const": "normal",
          "description": "Sample from normal distribution (deterministic with seed)",
          "type": "string"
        },
        {
          "const": "log_normal",
          "description": "Sample from log-normal distribution (deterministic with seed)",
          "type": "string"
        },
        {
          "const": "override",
          "description": "Explicit period overrides",
          "type": "string"
        },
        {
          "const": "time_series",
          "description": "Reference external time series",
          "type": "string"
        },
        {
          "const": "seasonal",
          "description": "Seasonal pattern (additive/multiplicative)",
          "type": "string"
        }
      ]
    },
    "ForecastSpec": {
      "additionalProperties": false,
      "description": "Forecast method specification.\n\nDefines how to forecast future values for a node.",
      "properties": {
        "method": {
          "$ref": "#/$defs/ForecastMethod",
          "description": "Forecast method"
        },
        "params": {
          "additionalProperties": true,
          "description": "Method-specific parameters",
          "type": "object"
        }
      },
      "required": [
        "method"
      ],
      "type": "object"
    },
    "FxConversionPolicy": {
      "description": "Standard FX conversion strategies used to hint FX providers.\n\nThe policy tells a provider *how* the rate will be applied so it can decide\nbetween spot, forward, or averaged sources.",
      "oneOf": [
        {
          "const": "cashflow_date",
          "description": "Use spot/forward on the cashflow date.",
          "type": "string"
        },
        {
          "const": "period_end",
          "description": "Use period end date.",
          "type": "string"
        },
        {
          "const": "period_average",
          "description": "Use an average over the period.",
          "type": "string"
        },
        {
          "const": "custom",
          "description": "Custom strategy defined by the caller/provider.",
          "type": "string"
        }
      ]
    },
    "Money": {
      "additionalProperties": false,
      "description": "Currency-tagged monetary amount with safe arithmetic.\n\nValues are stored using a fixed-point representation derived from ISO 4217\ndecimal places.\n\nWhen you need configurable rounding during ingestion, use\n[`Money::new_with_config`].\n\n# Examples\n```rust\nuse finstack_quant_core::money::Money;\nuse finstack_quant_core::currency::Currency;\n\nlet notional = Money::new(1_000_000.0, Currency::EUR);\nassert_eq!(notional.currency(), Currency::EUR);\nassert_eq!(notional.amount(), 1_000_000.0);\n```",
      "properties": {
        "amount": {
          "pattern": "^-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$",
          "type": [
            "string",
            "number"
          ]
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "NodeId": {
      "type": "string"
    },
    "NodeSpec": {
      "additionalProperties": false,
      "description": "Specification for a single node (metric/line item) in the financial model.\n\nA node can be:\n- **Value**: Explicit values only\n- **Calculated**: Formula-derived only\n- **Mixed**: Value OR Forecast OR Formula (precedence: Value > Forecast > Formula)",
      "properties": {
        "forecast": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForecastSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Forecast specification (for Mixed nodes)"
        },
        "formula_text": {
          "description": "Formula text (for Calculated and Mixed nodes)",
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "additionalProperties": true,
          "description": "Additional metadata",
          "type": "object"
        },
        "name": {
          "description": "Human-readable name (optional)",
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "$ref": "#/$defs/NodeId",
          "description": "Unique identifier for this node"
        },
        "node_type": {
          "$ref": "#/$defs/NodeType",
          "description": "Node computation type"
        },
        "tags": {
          "description": "Tags for grouping/filtering",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "value_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeValueType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Value type (monetary with currency or scalar)"
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/AmountOrScalar"
          },
          "description": "Explicit values per period (for Value and Mixed nodes)",
          "type": [
            "object",
            "null"
          ]
        },
        "where_text": {
          "description": "Where clause for conditional evaluation (optional)",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "node_id",
        "node_type"
      ],
      "type": "object"
    },
    "NodeType": {
      "description": "Node computation type.\n\nDetermines how a node's value is computed:\n- **Value**: Only explicit values (actuals, assumptions)\n- **Calculated**: Only formula-derived\n- **Mixed**: Value OR Forecast OR Formula (precedence: Value > Forecast > Formula)",
      "oneOf": [
        {
          "const": "value",
          "description": "Only explicit values",
          "type": "string"
        },
        {
          "const": "calculated",
          "description": "Only formula-derived",
          "type": "string"
        },
        {
          "const": "mixed",
          "description": "Value OR Forecast OR Formula (precedence: Value > Forecast > Formula)",
          "type": "string"
        }
      ]
    },
    "NodeValueType": {
      "description": "Node value type classification.\n\nDetermines whether a node represents monetary values (with a specific currency)\nor scalar values (ratios, percentages, counts, etc.).",
      "oneOf": [
        {
          "description": "Monetary value with a specific currency (e.g., revenue, costs, balance sheet items)",
          "properties": {
            "currency": {
              "$ref": "#/$defs/Currency",
              "description": "Currency of the monetary value"
            },
            "type": {
              "const": "monetary",
              "type": "string"
            }
          },
          "required": [
            "type",
            "currency"
          ],
          "type": "object"
        },
        {
          "description": "Unitless scalar value (e.g., ratios, percentages, counts)",
          "properties": {
            "type": {
              "const": "scalar",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "PaymentPriority": {
      "description": "Payment priority levels in the waterfall.",
      "oneOf": [
        {
          "const": "fees",
          "description": "Fees (commitment fees, facility fees, etc.)",
          "type": "string"
        },
        {
          "const": "interest",
          "description": "Cash interest payments",
          "type": "string"
        },
        {
          "const": "amortization",
          "description": "Scheduled amortization",
          "type": "string"
        },
        {
          "const": "mandatory_prepayment",
          "description": "Mandatory prepayments",
          "type": "string"
        },
        {
          "const": "voluntary_prepayment",
          "description": "Voluntary prepayments",
          "type": "string"
        },
        {
          "const": "sweep",
          "description": "Excess cash flow sweep",
          "type": "string"
        },
        {
          "const": "equity",
          "description": "Equity distributions",
          "type": "string"
        }
      ]
    },
    "PikToggleSpec": {
      "additionalProperties": false,
      "description": "PIK toggle specification.\n\nDefines conditions for switching between cash and PIK interest modes.\n\n# Hysteresis\n\nSet `min_periods_in_pik` to prevent oscillation when the liquidity metric\nhovers near the threshold. Once PIK is triggered, it stays active for at\nleast that many periods before it can switch back.\n\nThresholds use the same scalar units as the referenced `liquidity_metric`.",
      "properties": {
        "liquidity_metric": {
          "description": "Node reference or formula for liquidity metric (e.g., \"cash_balance\" or \"ebitda / interest_expense\")",
          "type": "string"
        },
        "min_periods_in_pik": {
          "default": 0,
          "description": "Minimum number of periods PIK must stay active once triggered (hysteresis).\nPrevents oscillation when the metric hovers near the threshold.\nDefault: 0 (no hysteresis, PIK can toggle every period).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "target_instrument_ids": {
          "description": "Target instrument IDs (if None, applies to all instruments with PIK capability)",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "threshold": {
          "description": "Threshold value: if metric < threshold, enable PIK; otherwise use cash",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "liquidity_metric",
        "threshold"
      ],
      "type": "object"
    },
    "WaterfallSpec": {
      "additionalProperties": false,
      "description": "Waterfall specification for dynamic cash flow allocation.\n\nDefines the priority of payments and sweep mechanics for capital structure.\n\nPayment priorities and optional sweep / PIK controls model common leveraged\nfinance behavior where scheduled debt service, excess cash flow sweeps, and\nequity leakage compete for the same cash pool.\n\n# Limitations\n\n- **No intra-category seniority.** Allocation within a payment category\n  (e.g. `Interest`, `Amortization`) is single-class **pro-rata** across all\n  instruments; there is no tranche seniority. A cash shortfall is shared\n  proportionally between a first-lien term loan and a mezzanine note alike.\n  Model strict 1L/2L subordination by running separate waterfalls or by\n  pre-allocating cash upstream.\n- **Prepayment penalties, call premiums, and original issue discount (OID)\n  are unsupported.** Prepayments (sweep, mandatory, voluntary) are applied\n  at par with no penalty or premium, and no OID accretion is modeled.",
      "properties": {
        "available_cash_node": {
          "description": "Optional formula or node reference for cash available to allocate in the waterfall.\n\nWhen omitted, the runtime preserves the legacy fully-funded scheduled cashflow behavior.",
          "type": [
            "string",
            "null"
          ]
        },
        "ecf_sweep": {
          "anyOf": [
            {
              "$ref": "#/$defs/EcfSweepSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Excess Cash Flow (ECF) sweep specification"
        },
        "pik_toggle": {
          "anyOf": [
            {
              "$ref": "#/$defs/PikToggleSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "PIK toggle specification for switching between cash and PIK interest"
        },
        "priority_of_payments": {
          "default": [
            "fees",
            "interest",
            "amortization",
            "sweep",
            "equity"
          ],
          "description": "Priority order of payments (default: Fees > Interest > Amortization > Sweep > Equity)",
          "items": {
            "$ref": "#/$defs/PaymentPriority"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/statements/1/financial_model_spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned financial statement model specification.",
  "properties": {
    "capital_structure": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapitalStructureSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "Capital structure specification (optional)"
    },
    "id": {
      "description": "Unique model identifier",
      "type": "string"
    },
    "meta": {
      "additionalProperties": true,
      "description": "Additional metadata",
      "type": "object"
    },
    "nodes": {
      "additionalProperties": {
        "$ref": "#/$defs/NodeSpec"
      },
      "description": "Map of node_id → NodeSpec",
      "type": "object"
    },
    "periods": {
      "description": "Ordered list of periods (quarters, months, etc.).\n\nEvaluation follows this order end-to-end (dependency resolution and time-series\nhelpers assume a single coherent timeline).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "description": "Exclusive ISO 8601 end date",
            "format": "date",
            "type": "string"
          },
          "id": {
            "description": "Period identifier such as 2025Q1",
            "type": "string"
          },
          "is_actual": {
            "description": "Whether the period contains actual rather than forecast data",
            "type": "boolean"
          },
          "start": {
            "description": "Inclusive ISO 8601 start date",
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "is_actual"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "description": "Schema version for forward compatibility.\n\nA missing key maps to legacy version 1 on the ordinary serde\ncompatibility path. Explicit versions outside the supported range fail\ndeserialization rather than silently accepting drift.",
      "format": "uint32",
      "maximum": 2,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "periods",
    "nodes"
  ],
  "title": "FinancialModelSpec",
  "type": "object"
}
