    "EvalWarning": {
      "description": "Warning emitted during evaluation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Division by zero encountered",
          "properties": {
            "DivisionByZero": {
              "properties": {
                "node_id": {
                  "description": "Identifier of the node that triggered the warning.",
                  "type": "string"
                },
                "period": {
                  "description": "Period in which the warning occurred.",
                  "type": "string"
                }
              },
              "required": [
                "node_id",
                "period"
              ],
              "type": "object"
            }
          },
          "required": [
            "DivisionByZero"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "NaN value bubbled up to a node result",
          "properties": {
            "NaNPropagated": {
              "properties": {
                "node_id": {
                  "description": "Identifier of the node that produced the NaN value.",
                  "type": "string"
                },
                "period": {
                  "description": "Period in which the warning occurred.",
                  "type": "string"
                }
              },
              "required": [
                "node_id",
                "period"
              ],
              "type": "object"
            }
          },
          "required": [
            "NaNPropagated"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-finite value (NaN, Inf, -Inf) detected when storing a node result.\n\nThis warning is emitted by the finiteness validation pipeline so that\nconsumers can identify which node/period introduced bad values.",
          "properties": {
            "NonFiniteValue": {
              "properties": {
                "node_id": {
                  "description": "Identifier of the node that produced the non-finite value.",
                  "type": "string"
                },
                "period": {
                  "description": "Period in which the warning occurred.",
                  "type": "string"
                },
                "value": {
                  "description": "The actual non-finite value (NaN, Inf, or -Inf).",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "node_id",
                "period",
                "value"
              ],
              "type": "object"
            }
          },
          "required": [
            "NonFiniteValue"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Capital-structure cashflow classification was ignored during statement extraction.",
          "properties": {
            "CapitalStructureCashflowIgnored": {
              "properties": {
                "cashflow_date": {
                  "description": "Original cashflow date as a string for diagnostics.",
                  "format": "date",
                  "type": "string"
                },
                "kind": {
                  "description": "Ignored cashflow kind.",
                  "type": "string"
                },
                "period": {
                  "description": "Period in which the ignored cashflow was encountered.",
                  "type": "string"
                }
              },
              "required": [
                "period",
                "kind",
                "cashflow_date"
              ],
              "type": "object"
            }
          },
          "required": [
            "CapitalStructureCashflowIgnored"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One or more non-finite inputs were skipped by a skip-NaN aggregate\n(`sum`, `mean`, ...).\n\nThe aggregate's skip-NaN policy is intentional, but silently dropping a\nbroken line item can mask upstream problems (e.g. a division by zero in\none argument), so the drop is surfaced here.",
          "properties": {
            "NonFiniteSkipped": {
              "properties": {
                "count": {
                  "description": "Number of non-finite inputs dropped.",
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "function": {
                  "description": "Name of the aggregate function that dropped values.",
                  "type": "string"
                },
                "node_id": {
                  "description": "Identifier of the node whose aggregate dropped inputs.",
                  "type": "string"
                },
                "period": {
                  "description": "Period in which the drop occurred.",
                  "type": "string"
                }
              },
              "required": [
                "node_id",
                "period",
                "function",
                "count"
              ],
              "type": "object"
            }
          },
          "required": [
            "NonFiniteSkipped"
          ],
          "type": "object"
        }
      ]
    },
    "Materiality": {
      "description": "Materiality context attached to a finding, describing its quantitative\nsignificance.",
      "properties": {
        "absolute": {
          "description": "Absolute amount of the discrepancy.",
          "format": "double",
          "type": "number"
        },
        "reference_label": {
          "description": "Human-readable label for the reference (e.g. \"total_assets\").",
          "type": "string"
        },
        "reference_value": {
          "description": "The reference (denominator) value used when computing `relative_pct`.",
          "format": "double",
          "type": "number"
        },
        "relative_pct": {
          "description": "Discrepancy as a percentage of the reference value.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "absolute",
        "relative_pct",
        "reference_value",
        "reference_label"
      ],
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "Currency-tagged monetary amount with safe arithmetic.\n\nValues are stored using a fixed-point representation derived from ISO 4217\ndecimal places.\n\nWhen you need configurable rounding during ingestion, use\n[`Money::new_with_config`].\n\n# Examples\n```rust\nuse finstack_quant_core::money::Money;\nuse finstack_quant_core::currency::Currency;\n\nlet notional = Money::new(1_000_000.0, Currency::EUR);\nassert_eq!(notional.currency(), Currency::EUR);\nassert_eq!(notional.amount(), 1_000_000.0);\n```",
      "properties": {
        "amount": {
          "pattern": "^-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$",
          "type": [
            "string",
            "number"
          ]
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "NodeId": {
      "type": "string"
    },
    "NodeValueType": {
      "description": "Node value type classification.\n\nDetermines whether a node represents monetary values (with a specific currency)\nor scalar values (ratios, percentages, counts, etc.).",
      "oneOf": [
        {
          "description": "Monetary value with a specific currency (e.g., revenue, costs, balance sheet items)",
          "properties": {
            "currency": {
              "$ref": "#/$defs/Currency",
              "description": "Currency of the monetary value"
            },
            "type": {
              "const": "monetary",
              "type": "string"
            }
          },
          "required": [
            "type",
            "currency"
          ],
          "type": "object"
        },
        {
          "description": "Unitless scalar value (e.g., ratios, percentages, counts)",
          "properties": {
            "type": {
              "const": "scalar",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "NumericMode": {
      "description": "Numeric mode used for evaluation.",
      "oneOf": [
        {
          "const": "float64",
          "description": "f64 floating-point mode (current default)",
          "type": "string"
        },
        {
          "const": "decimal",
          "description": "Reserved fixed-point mode.\n\nThe variant remains in the serde/public API so saved result metadata can\nevolve without renaming the enum. The evaluator currently emits\n[`NumericMode::Float64`] only.",
          "type": "string"
        }
      ]
    },
    "ResultsMeta": {
      "description": "Metadata about evaluation results.",
      "properties": {
        "eval_time_ms": {
          "description": "Evaluation time in milliseconds",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "num_nodes": {
          "description": "Number of nodes evaluated",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "num_periods": {
          "description": "Number of periods evaluated",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "numeric_mode": {
          "$ref": "#/$defs/NumericMode",
          "default": "float64",
          "description": "Numeric mode used for evaluation"
        },
        "parallel": {
          "default": false,
          "description": "Whether parallel evaluation was used",
          "type": "boolean"
        },
        "rounding_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoundingContext"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rounding context reserved for future fixed-point evaluation metadata.\n\nKept in the wire format for forward compatibility; statement evaluation\ncurrently runs in [`NumericMode::Float64`] and leaves this as `None`."
        },
        "warnings": {
          "description": "Warnings encountered during evaluation (division by zero, NaN propagation, etc.)",
          "items": {
            "$ref": "#/$defs/EvalWarning"
          },
          "type": "array"
        }
      },
      "required": [
        "num_nodes",
        "num_periods"
      ],
      "type": "object"
    },
    "RoundingContext": {
      "description": "Snapshot of active rounding settings used for result stamping.\n\nInstances are typically produced via [`rounding_context_from`] and persisted\nalongside valuation results.",
      "properties": {
        "ingest_scale_by_ccy": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Ingest scale map snapshot by currency code.",
          "type": "object"
        },
        "mode": {
          "$ref": "#/$defs/RoundingMode",
          "description": "Active rounding mode."
        },
        "output_scale_by_ccy": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Output scale map snapshot by currency code.",
          "type": "object"
        },
        "tolerances": {
          "$ref": "#/$defs/ToleranceConfig",
          "default": {
            "generic_epsilon": 1e-10,
            "rate_epsilon": 1e-12
          },
          "description": "Tolerance settings snapshot for floating-point comparisons."
        },
        "version": {
          "description": "Schema version for forward compatibility.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "ingest_scale_by_ccy",
        "output_scale_by_ccy",
        "version"
      ],
      "type": "object"
    },
    "RoundingMode": {
      "description": "Rounding modes supported by the library.\n\nThe variants mirror the most common conventions found in pricing engines.\n\n# Examples\n```rust\nuse finstack_quant_core::config::{FinstackConfig, RoundingMode};\n\nlet mut cfg = FinstackConfig::default();\ncfg.rounding.mode = RoundingMode::TowardZero;\nassert!(matches!(cfg.rounding.mode, RoundingMode::TowardZero));\n```",
      "oneOf": [
        {
          "const": "Bankers",
          "description": "Banker's rounding (ties to even).",
          "type": "string"
        },
        {
          "const": "AwayFromZero",
          "description": "Round halves away from zero.",
          "type": "string"
        },
        {
          "const": "TowardZero",
          "description": "Round toward zero (truncate).",
          "type": "string"
        },
        {
          "const": "Floor",
          "description": "Round toward negative infinity.",
          "type": "string"
        },
        {
          "const": "Ceil",
          "description": "Round toward positive infinity.",
          "type": "string"
        }
      ]
    },
    "Severity": {
      "description": "Severity level for a check finding, ordered from least to most severe.",
      "oneOf": [
        {
          "const": "info",
          "description": "Informational finding — no action required.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Warning — review recommended.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Error — indicates a likely problem that should be addressed.",
          "type": "string"
        }
      ]
    },
    "ToleranceConfig": {
      "description": "Numerical tolerance configuration for floating-point comparisons.\n\nProvides configurable epsilon values for zero-checks in rate calculations\nand generic floating-point comparisons. These defaults are chosen to balance\nnumerical stability with practical precision requirements.\n\n# Examples\n```rust\nuse finstack_quant_core::config::ToleranceConfig;\n\nlet mut tol = ToleranceConfig::default();\nassert_eq!(tol.rate_epsilon, 1e-12);\n\n// Customize for stricter rate comparisons\ntol.rate_epsilon = 1e-14;\n```",
      "properties": {
        "generic_epsilon": {
          "default": 1e-10,
          "description": "Epsilon for generic floating-point comparisons (default: 1e-10).\n\nUsed for general numerical comparisons where higher tolerance is acceptable.",
          "format": "double",
          "type": "number"
        },
        "rate_epsilon": {
          "default": 1e-12,
          "description": "Epsilon for rate comparisons (default: 1e-12).\n\nUsed when comparing interest rates, yields, and other small ratios.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/statements/1/statement_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Versioned financial statement evaluation result.",
  "properties": {
    "check_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckReport"
        },
        {
          "type": "null"
        }
      ],
      "description": "Check report from inline validation (None if no checks configured)"
    },
    "cs_cashflows": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapitalStructureCashflows"
        },
        {
          "type": "null"
        }
      ],
      "description": "Capital structure cashflows (populated when model has a capital_structure)"
    },
    "meta": {
      "$ref": "#/$defs/ResultsMeta",
      "description": "Metadata about the evaluation"
    },
    "monetary_nodes": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/Money"
        },
        "type": "object"
      },
      "description": "Map of node_id → (period_id → Money) for monetary nodes",
      "type": "object"
    },
    "node_value_types": {
      "additionalProperties": {
        "$ref": "#/$defs/NodeValueType"
      },
      "description": "Track value types for each node",
      "type": "object"
    },
    "nodes": {
      "additionalProperties": {
        "additionalProperties": {
          "format": "double",
          "type": "number"
        },
        "type": "object"
      },
      "description": "Map of node_id → (period_id → value) [f64 for scalar results]",
      "type": "object"
    },
    "schema_version": {
      "default": 1,
      "description": "Wire-format schema version. Current wire format: `STATEMENT_RESULT_SCHEMA_VERSION`.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "nodes",
    "meta"
  ],
  "title": "StatementResult",
  "type": "object"
}
