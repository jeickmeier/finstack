{
  "$defs": {
    "CapitalStructureCashflows": {
      "additionalProperties": false,
      "description": "Aggregated cashflows from capital structure instruments by period.\n\nInstances of this type are produced by the evaluator and exposed to the DSL\nvia the `cs.*` namespace. It keeps both per-instrument details and totals so\nthat downstream consumers can drill down or report aggregates.\n\nMonetary fields are stored as [`Money`] to preserve currency identity. The\naccessor methods return raw `f64` amounts in the reporting currency for\nconvenience; callers that need full currency fidelity should inspect the\nunderlying maps directly.\n\n# Example\n\n```rust\n# use finstack_quant_statements::capital_structure::{CapitalStructureCashflows, CashflowBreakdown};\n# use finstack_quant_core::dates::PeriodId;\n# use finstack_quant_core::money::Money;\n# use finstack_quant_core::currency::Currency;\nlet mut cs = CapitalStructureCashflows::new();\nlet period = PeriodId::quarter(2025, 1);\ncs.by_instrument\n    .entry(\"BOND-1\".into())\n    .or_default()\n    .insert(period, CashflowBreakdown {\n        interest_expense_cash: Money::new(10_000.0, Currency::USD),\n        interest_income_cash: None,\n        interest_expense_pik: Money::new(2_500.0, Currency::USD),\n        principal_payment: Money::new(100_000.0, Currency::USD),\n        fees: Money::new(0.0, Currency::USD),\n        debt_balance: Money::new(4_900_000.0, Currency::USD),\n        accrued_interest: Money::new(5_000.0, Currency::USD),\n    });\ncs.totals.insert(period, CashflowBreakdown {\n    interest_expense_cash: Money::new(10_000.0, Currency::USD),\n    interest_income_cash: None,\n    interest_expense_pik: Money::new(2_500.0, Currency::USD),\n    principal_payment: Money::new(100_000.0, Currency::USD),\n    fees: Money::new(0.0, Currency::USD),\n    debt_balance: Money::new(4_900_000.0, Currency::USD),\n    accrued_interest: Money::new(5_000.0, Currency::USD),\n});\n\nassert_eq!(cs.get_total_interest(&period).unwrap(), 12_500.0);\n```",
      "properties": {
        "by_instrument": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/CashflowBreakdown"
            },
            "type": "object"
          },
          "description": "Map of instrument_id → (period_id → cashflow_type → amount)",
          "type": "object"
        },
        "equity_distribution": {
          "additionalProperties": {
            "$ref": "#/$defs/Money"
          },
          "description": "Post-waterfall residual cash distributed to equity per period.\n\nOnly populated by waterfall evaluation when `available_cash_node` is\nconfigured: it is the cash remaining after fees, interest, and\nprincipal allocations. With the per-period allocations this satisfies\n`fees + cash interest + principal + equity == available cash`.",
          "type": "object"
        },
        "reporting_currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reporting currency used for `totals` (if populated)"
        },
        "totals": {
          "additionalProperties": {
            "$ref": "#/$defs/CashflowBreakdown"
          },
          "description": "Total cashflows across all instruments in the reporting currency (if available)",
          "type": "object"
        },
        "totals_by_currency": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/CashflowBreakdown"
            },
            "type": "object"
          },
          "description": "Totals bucketed by native instrument currency",
          "type": "object"
        }
      },
      "required": [
        "by_instrument"
      ],
      "type": "object"
    },
    "CashflowBreakdown": {
      "additionalProperties": false,
      "description": "Breakdown of cashflows by type for a single period.\n\nOutflow-like fields such as interest, fees, and principal payments are\nstored as positive amounts representing debt service paid or accrued during\nthe period.\n\nInterest expense is split into cash and PIK components for visibility\ninto non-cash interest accrual. Use `interest_expense_total()` for the\ncombined value. All monetary fields use the Money type for currency safety.\n\nInterest *expense* and interest *income* are tracked separately rather than\nas one signed field: a two-leg instrument (an interest-rate swap) can net to\na receipt in a period — a pay-fixed hedge is in the money whenever the\nfloating leg exceeds the fixed leg — and a receipt is not debt service. The\nwaterfall allocates cash against expense claims, so folding a receipt into\n`interest_expense_cash` as a negative claim would corrupt pro-rata\nallocation. See [`Self::net_interest_expense_cash`] for the combined view.",
      "properties": {
        "accrued_interest": {
          "$ref": "#/$defs/Money",
          "description": "Accrued interest not yet paid (liability)"
        },
        "debt_balance": {
          "$ref": "#/$defs/Money",
          "description": "Outstanding debt balance at period end"
        },
        "fees": {
          "$ref": "#/$defs/Money",
          "description": "Fees (commitment fees, etc.)"
        },
        "interest_expense_cash": {
          "$ref": "#/$defs/Money",
          "description": "Cash interest payments (coupons, floating resets)"
        },
        "interest_expense_pik": {
          "$ref": "#/$defs/Money",
          "description": "PIK (payment-in-kind) interest accrued but not paid in cash"
        },
        "interest_income_cash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "description": "Net cash interest **received** during the period.\n\nNon-zero only for two-leg instruments whose legs net to a receipt (e.g.\nan in-the-money pay-fixed swap). Stored as a positive amount, like the\noutflow-oriented fields, and reported through the `cs.interest_income`\nnamespace.\n\n`None` in payloads written before this field existed, which is\nsemantically identical to the old behaviour (no income was tracked).\nRead it via [`Self::interest_income_cash_or_zero`] rather than\nunwrapping, so legacy payloads resolve to a zero in the correct\ncurrency."
        },
        "principal_payment": {
          "$ref": "#/$defs/Money",
          "description": "Principal repayments (amortization, maturity)"
        }
      },
      "required": [
        "interest_expense_cash",
        "interest_expense_pik",
        "principal_payment",
        "fees",
        "debt_balance",
        "accrued_interest"
      ],
      "type": "object"
    },
    "CheckCategory": {
      "description": "Category that groups related checks together.",
      "oneOf": [
        {
          "const": "accounting_identity",
          "description": "Balance sheet balances, retained earnings flow-through, cash ties",
          "type": "string"
        },
        {
          "const": "cross_statement_reconciliation",
          "description": "Depreciation ties to PP&E, interest ties to debt schedule, etc.",
          "type": "string"
        },
        {
          "const": "internal_consistency",
          "description": "Growth rate plausibility, effective tax rate range, WC consistency",
          "type": "string"
        },
        {
          "const": "credit_reasonableness",
          "description": "Leverage ranges, coverage floors, FCF sign, liquidity runway",
          "type": "string"
        },
        {
          "const": "data_quality",
          "description": "Missing values, NaN/Inf, sign conventions",
          "type": "string"
        }
      ]
    },
    "CheckFinding": {
      "description": "A single finding produced by a check for a specific period or node.",
      "properties": {
        "check_id": {
          "description": "Identifier of the check that produced this finding.",
          "type": "string"
        },
        "materiality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Materiality"
            },
            {
              "type": "null"
            }
          ],
          "description": "Materiality context, if applicable."
        },
        "message": {
          "description": "Human-readable description of the issue.",
          "type": "string"
        },
        "nodes": {
          "description": "Node identifiers involved in the finding.",
          "items": {
            "$ref": "#/$defs/NodeId"
          },
          "type": "array"
        },
        "period": {
          "description": "Period the finding relates to, if applicable.",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "description": "Severity of the finding."
        }
      },
      "required": [
        "check_id",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "CheckReport": {
      "description": "Full report aggregating all [`CheckResult`]s from a check run.",
      "properties": {
        "results": {
          "description": "Individual results for each check.",
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/CheckSummary",
          "description": "Aggregate summary."
        }
      },
      "required": [
        "results",
        "summary"
      ],
      "type": "object"
    },
    "CheckResult": {
      "description": "Outcome of a single check execution.",
      "properties": {
        "category": {
          "$ref": "#/$defs/CheckCategory",
          "description": "Category this check belongs to."
        },
        "check_id": {
          "description": "Identifier of the check.",
          "type": "string"
        },
        "check_name": {
          "description": "Human-readable name of the check.",
          "type": "string"
        },
        "findings": {
          "description": "Individual findings produced by the check.",
          "items": {
            "$ref": "#/$defs/CheckFinding"
          },
          "type": "array"
        },
        "passed": {
          "description": "Whether the check passed (no error-severity findings).",
          "type": "boolean"
        }
      },
      "required": [
        "check_id",
        "check_name",
        "category",
        "passed",
        "findings"
      ],
      "type": "object"
    },
    "CheckSummary": {
      "description": "Aggregate counts for a completed check run.",
      "properties": {
        "errors": {
          "description": "Total number of error-severity findings across all checks.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "description": "Number of checks that failed (at least one error-severity finding).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "infos": {
          "description": "Total number of info-severity findings across all checks.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "description": "Number of checks that passed.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total_checks": {
          "description": "Total number of checks executed.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "description": "Total number of warning-severity findings across all checks.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total_checks",
        "passed",
        "failed",
        "errors",
        "warnings",
        "infos"
      ],
      "type": "object"
    },
