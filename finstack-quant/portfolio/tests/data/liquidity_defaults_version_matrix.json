    },
    {
      "name": "missing-version",
      "schema": "finstack_quant.portfolio.liquidity_defaults/1",
      "version": null,
      "expected": "missing field `version`"
    },
    {
      "name": "zero",
      "schema": "finstack_quant.portfolio.liquidity_defaults/0",
      "version": 0,
      "expected": "unsupported"
    },
    {
      "name": "future",
      "schema": "finstack_quant.portfolio.liquidity_defaults/2",
      "version": 2,
      "expected": "unsupported"
    },
    {
      "name": "malformed-schema",
      "schema": "finstack_quant.portfolio.liquidity_defaults/not-a-version",
      "version": 1,
      "expected": "malformed"
    },
    {
      "name": "malformed-version",
      "schema": "finstack_quant.portfolio.liquidity_defaults/1",
      "version": "one",
