{
  "$defs": {
    "FxSpot": {
      "additionalProperties": false,
      "description": "FX Spot instrument (1 unit of `base` priced in `quote`).\n\nRepresents the spot exchange rate between two currencies following\nstandard market quoting conventions (base/quote or CCY1/CCY2).\n\n# Quote Convention\n\nThe rate is interpreted as: **1 unit of base = rate units of quote**\n\nFor example, if `base = EUR`, `quote = USD`, and `spot_rate = 1.10`:\n- 1 EUR = 1.10 USD\n- This is the \"EUR/USD\" rate\n\n# Settlement\n\nFX spot typically settles T+2 (two business days after trade date).\nThis can be customized via `settlement_lag_days`.\n\nSee module-level documentation for comprehensive FX quoting conventions.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json"
        },
        "base_calendar_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json"
        },
        "business_day_convention": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/business_day_convention.schema.json",
          "default": "modified_following"
        },
        "discount_curve_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "default": {}
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "default": {
            "mc_seed_scenario": null,
            "theta_period": null
          }
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        "quote_calendar_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote_currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "default": {}
        },
        "settlement": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "settlement_lag_days": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "spot_rate": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "base_currency",
        "quote_currency",
        "notional",
        "attributes"
      ],
      "type": "object"
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "fx_spot": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/FxSpot"
        },
        "type": {
          "const": "fx_spot",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/fx/fx_spot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "base_calendar_id": null,
          "base_currency": "EUR",
          "business_day_convention": "modified_following",
          "id": "EURUSD",
          "notional": {
            "amount": "1000000",
            "currency": "EUR"
          },
          "quote_calendar_id": null,
          "quote_currency": "USD",
          "settlement": null,
          "settlement_lag_days": 2,
          "spot_rate": 1.1
        },
        "type": "fx_spot"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/fx_spot"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "fx_spot",
  "type": "object"
}
