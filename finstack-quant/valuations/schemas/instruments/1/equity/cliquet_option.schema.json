{
  "$defs": {
    "CliquetOption": {
      "additionalProperties": false,
      "description": "Cliquet option instrument.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "div_yield_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
        },
        "global_cap": {
          "format": "double",
          "type": "number"
        },
        "global_floor": {
          "format": "double",
          "type": "number"
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "initial_level": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "default": {}
        },
        "local_cap": {
          "format": "double",
          "type": "number"
        },
        "local_floor": {
          "format": "double",
          "type": "number"
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "default": {
            "mc_seed_scenario": null,
            "theta_period": null
          }
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        "past_fixings": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              {
                "format": "double",
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "payoff_type": {
          "$ref": "#/$defs/CliquetPayoffType",
          "default": "additive"
        },
        "reset_dates": {
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "default": {}
        },
        "spot_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "underlying_ticker": {
          "type": "string"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        }
      },
      "required": [
        "id",
        "underlying_ticker",
        "reset_dates",
        "expiry",
        "local_cap",
        "local_floor",
        "global_cap",
        "global_floor",
        "notional",
        "day_count",
        "discount_curve_id",
        "spot_id",
        "vol_surface_id",
        "attributes"
      ],
      "type": "object"
    },
    "CliquetPayoffType": {
      "description": "Cliquet payoff aggregation type.",
      "oneOf": [
        {
          "const": "additive",
          "description": "Additive: Sum of period returns",
          "type": "string"
        },
        {
          "const": "multiplicative",
          "description": "Multiplicative: Product of (1 + period returns) - 1",
          "type": "string"
        }
      ]
    },
    "InstrumentSchema": {
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "oneOf": [
        {
          "const": "finstack_quant.instrument/1",
          "description": "The sole supported instrument contract.",
          "type": "string"
        }
      ]
    },
    "SingleInstrumentJson": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "spec": {
              "$ref": "#/$defs/CliquetOption"
            },
            "type": {
              "const": "cliquet_option",
              "type": "string"
            }
          },
          "required": [
            "type",
            "spec"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/equity/cliquet_option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "div_yield_id": "SPX-DIV",
          "expiry": "2024-12-31",
          "global_cap": 0.2,
          "global_floor": 0.0,
          "id": "CLIQ-SPX-QTR",
          "initial_level": null,
          "local_cap": 0.05,
          "local_floor": 0.0,
          "notional": {
            "amount": "100000",
            "currency": "USD"
          },
          "past_fixings": [],
          "payoff_type": "additive",
          "reset_dates": [
            "2024-03-29",
            "2024-06-28",
            "2024-09-30",
            "2024-12-31"
          ],
          "spot_id": "SPX-SPOT",
          "underlying_ticker": "SPX",
          "vol_surface_id": "SPX-VOL"
        },
        "type": "cliquet_option"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/SingleInstrumentJson"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "cliquet_option",
  "type": "object"
}
