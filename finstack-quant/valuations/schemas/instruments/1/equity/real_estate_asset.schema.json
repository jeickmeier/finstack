{
  "$defs": {
    "InstrumentSchema": {
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "oneOf": [
        {
          "const": "finstack_quant.instrument/1",
          "description": "The sole supported instrument contract.",
          "type": "string"
        }
      ]
    },
    "RealEstateAsset": {
      "additionalProperties": false,
      "description": "Real estate asset valuation instrument.\n\nSupports DCF (explicit NOI schedule) and direct capitalization valuation.",
      "properties": {
        "acquisition_cost": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "acquisition_costs": {
          "default": [],
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
          },
          "type": "array"
        },
        "appraisal_value": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "default": {}
        },
        "cap_rate": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "capex_schedule": {
          "default": null,
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              {
                "format": "double",
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "discount_rate": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "disposition_cost_pct": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "disposition_costs": {
          "default": [],
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
          },
          "type": "array"
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "default": {}
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "default": {
            "mc_seed_scenario": null,
            "theta_period": null
          }
        },
        "noi_schedule": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              {
                "format": "double",
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "property_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/RealEstatePropertyType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "purchase_price": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sale_date": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sale_price": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "default": {}
        },
        "stabilized_noi": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "terminal_cap_rate": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "terminal_growth_rate": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "valuation_date": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
        },
        "valuation_method": {
          "$ref": "#/$defs/RealEstateValuationMethod"
        }
      },
      "required": [
        "id",
        "currency",
        "valuation_date",
        "valuation_method",
        "noi_schedule",
        "day_count",
        "discount_curve_id"
      ],
      "type": "object"
    },
    "RealEstatePropertyType": {
      "description": "Broad property classification for reporting / tagging.",
      "oneOf": [
        {
          "const": "office",
          "description": "Office (CBD/suburban, single-tenant or multi-tenant).",
          "type": "string"
        },
        {
          "const": "multifamily",
          "description": "Multifamily / residential rental.",
          "type": "string"
        },
        {
          "const": "retail",
          "description": "Retail (strip, mall, big box, high street).",
          "type": "string"
        },
        {
          "const": "industrial",
          "description": "Industrial (warehouse, logistics, manufacturing).",
          "type": "string"
        },
        {
          "const": "hospitality",
          "description": "Hospitality (hotel, resort).",
          "type": "string"
        },
        {
          "const": "mixed_use",
          "description": "Mixed-use (multiple property types).",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Other / uncategorized.",
          "type": "string"
        }
      ]
    },
    "RealEstateValuationMethod": {
      "description": "Valuation method for a real estate asset.",
      "oneOf": [
        {
          "const": "dcf",
          "description": "Discounted cashflow using an explicit NOI schedule and discount rate.",
          "type": "string"
        },
        {
          "const": "direct_cap",
          "description": "Direct capitalization using a stabilized NOI and cap rate.",
          "type": "string"
        }
      ]
    },
    "real_estate_asset": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "spec": {
              "$ref": "#/$defs/RealEstateAsset"
            },
            "type": {
              "const": "real_estate_asset",
              "type": "string"
            }
          },
          "required": [
            "type",
            "spec"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/equity/real_estate_asset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "currency": "USD",
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "discount_rate": 0.08,
          "id": "RE-OFFICE-DCF",
          "noi_schedule": [
            [
              "2026-01-01",
              100000.0
            ],
            [
              "2027-01-01",
              100000.0
            ],
            [
              "2028-01-01",
              100000.0
            ],
            [
              "2029-01-01",
              100000.0
            ],
            [
              "2030-01-01",
              100000.0
            ]
          ],
          "property_type": "office",
          "terminal_cap_rate": 0.055,
          "valuation_date": "2025-01-01",
          "valuation_method": "dcf"
        },
        "type": "real_estate_asset"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/real_estate_asset"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "real_estate_asset",
  "type": "object"
}
