{
  "$defs": {
    "ExerciseStyle": {
      "description": "Exercise style for options",
      "oneOf": [
        {
          "const": "european",
          "description": "European exercise (only at expiry)",
          "type": "string"
        },
        {
          "const": "american",
          "description": "American exercise (any time before/at expiry)",
          "type": "string"
        },
        {
          "const": "bermudan",
          "description": "Bermudan exercise (specific dates before expiry)",
          "type": "string"
        }
      ]
    },
    "InstrumentSchema": {
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "oneOf": [
        {
          "const": "finstack_quant.instrument/1",
          "description": "The sole supported instrument contract.",
          "type": "string"
        }
      ]
    },
    "OptionType": {
      "description": "Option type for pricing",
      "oneOf": [
        {
          "const": "call",
          "description": "Call option",
          "type": "string"
        },
        {
          "const": "put",
          "description": "Put option",
          "type": "string"
        }
      ]
    },
    "VolIndexOptionSpecs": {
      "additionalProperties": false,
      "description": "Contract specifications for volatility index options.",
      "properties": {
        "index_id": {
          "description": "Index identifier (e.g., \"VIX\", \"VXN\", \"VSTOXX\").",
          "type": "string"
        },
        "multiplier": {
          "description": "Contract multiplier (USD per index point).\nVIX options standard: 100 (each point = $100)",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "multiplier",
        "index_id"
      ],
      "type": "object"
    },
    "VolatilityIndexOption": {
      "additionalProperties": false,
      "description": "Volatility Index Option instrument.\n\nEuropean-style options on volatility indices (VIX, VXN, VSTOXX).\nPriced using the Black model with the vol index forward as underlying.\n\n# Examples\n\n```rust\nuse finstack_quant_valuations::instruments::equity::vol_index_option::VolatilityIndexOption;\nuse finstack_quant_valuations::instruments::OptionType;\nuse finstack_quant_core::currency::Currency;\nuse finstack_quant_core::dates::{Date, DayCount};\nuse finstack_quant_core::money::Money;\nuse finstack_quant_core::types::{CurveId, InstrumentId};\nuse time::Month;\n\nlet option = VolatilityIndexOption::builder()\n    .id(InstrumentId::new(\"VIX-CALL-20-2025M03\"))\n    .notional(Money::new(10_000.0, Currency::USD))\n    .strike(20.0)\n    .option_type(OptionType::Call)\n    .expiry(Date::from_calendar_date(2025, Month::March, 19).unwrap())\n    .day_count(DayCount::Act365F)\n    .discount_curve_id(CurveId::new(\"USD-OIS\"))\n    .vol_index_curve_id(CurveId::new(\"VIX\"))\n    .vol_of_vol_surface_id(CurveId::new(\"VIX-VOLVOL\"))\n    .build()\n    .expect(\"Valid option\");\n```",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "default": {}
        },
        "contract_specs": {
          "$ref": "#/$defs/VolIndexOptionSpecs",
          "default": {
            "index_id": "VIX",
            "multiplier": 100.0
          }
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "exercise_style": {
          "$ref": "#/$defs/ExerciseStyle",
          "default": "european"
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
        },
        "expiry_fixing": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "default": {}
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "default": {
            "mc_seed_scenario": null,
            "theta_period": null
          }
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        "option_type": {
          "$ref": "#/$defs/OptionType"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "default": {}
        },
        "settlement_date": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strike": {
          "format": "double",
          "type": "number"
        },
        "vol_index_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "vol_of_vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        }
      },
      "required": [
        "id",
        "notional",
        "strike",
        "option_type",
        "expiry",
        "day_count",
        "discount_curve_id",
        "vol_index_curve_id",
        "vol_of_vol_surface_id"
      ],
      "type": "object"
    },
    "volatility_index_option": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "spec": {
              "$ref": "#/$defs/VolatilityIndexOption"
            },
            "type": {
              "const": "volatility_index_option",
              "type": "string"
            }
          },
          "required": [
            "type",
            "spec"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/equity/volatility_index_option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "contract_specs": {
            "index_id": "VIX",
            "multiplier": 100.0
          },
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "exercise_style": "european",
          "expiry": "2025-03-19",
          "id": "VIX-CALL-20-2025M03",
          "notional": {
            "amount": "10000",
            "currency": "USD"
          },
          "option_type": "call",
          "strike": 20.0,
          "vol_index_curve_id": "VIX",
          "vol_of_vol_surface_id": "VIX-VOLVOL"
        },
        "type": "volatility_index_option"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/volatility_index_option"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "volatility_index_option",
  "type": "object"
}
