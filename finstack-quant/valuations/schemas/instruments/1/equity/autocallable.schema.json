{
  "$defs": {
    "Autocallable": {
      "additionalProperties": false,
      "description": "Autocallable structured product instrument.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json"
        },
        "autocall_barriers": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "cap_level": {
          "format": "double",
          "type": "number"
        },
        "coupons": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "div_yield_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
        },
        "final_barrier": {
          "format": "double",
          "type": "number"
        },
        "final_payoff_type": {
          "$ref": "#/$defs/FinalPayoffType"
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "initial_level": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "default": {}
        },
        "memory_coupons": {
          "default": false,
          "type": "boolean"
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "default": {
            "mc_seed_scenario": null,
            "theta_period": null
          }
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        "observation_dates": {
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "participation_rate": {
          "format": "double",
          "type": "number"
        },
        "past_fixings": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              {
                "format": "double",
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "default": {}
        },
        "spot_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        },
        "underlying_ticker": {
          "type": "string"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
        }
      },
      "required": [
        "id",
        "underlying_ticker",
        "observation_dates",
        "expiry",
        "autocall_barriers",
        "coupons",
        "final_barrier",
        "final_payoff_type",
        "participation_rate",
        "cap_level",
        "notional",
        "day_count",
        "discount_curve_id",
        "spot_id",
        "vol_surface_id",
        "attributes"
      ],
      "type": "object"
    },
    "FinalPayoffType": {
      "description": "Final payoff type for autocallable products.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Capital protection: max(floor, participation * min(S_T/S_0, cap))",
          "properties": {
            "capital_protection": {
              "properties": {
                "floor": {
                  "description": "Minimum return floor (e.g., 1.0 for 100% protection)",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "floor"
              ],
              "type": "object"
            }
          },
          "required": [
            "capital_protection"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Participation: 1 + participation_rate * max(0, S_T/S_0 - 1)",
          "properties": {
            "participation": {
              "properties": {
                "rate": {
                  "description": "Participation rate in upside (e.g., 1.0 for 100% participation)",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "rate"
              ],
              "type": "object"
            }
          },
          "required": [
            "participation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Knock-in put: Put option if barrier breached, otherwise return principal",
          "properties": {
            "knock_in_put": {
              "properties": {
                "strike": {
                  "description": "Strike price for knock-in put option",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "strike"
              ],
              "type": "object"
            }
          },
          "required": [
            "knock_in_put"
          ],
          "type": "object"
        }
      ]
    },
    "InstrumentSchema": {
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "oneOf": [
        {
          "const": "finstack_quant.instrument/1",
          "description": "The sole supported instrument contract.",
          "type": "string"
        }
      ]
    },
    "autocallable": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "spec": {
              "$ref": "#/$defs/Autocallable"
            },
            "type": {
              "const": "autocallable",
              "type": "string"
            }
          },
          "required": [
            "type",
            "spec"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/equity/autocallable.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "autocall_barriers": [
            1.0,
            1.0,
            1.0,
            1.0
          ],
          "cap_level": 1.5,
          "coupons": [
            0.02,
            0.02,
            0.02,
            0.02
          ],
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "div_yield_id": "SPX-DIV",
          "expiry": "2024-12-31",
          "final_barrier": 0.6,
          "final_payoff_type": {
            "participation": {
              "rate": 1.0
            }
          },
          "id": "AUTO-SPX-QTR",
          "initial_level": null,
          "memory_coupons": false,
          "notional": {
            "amount": "100000",
            "currency": "USD"
          },
          "observation_dates": [
            "2024-03-29",
            "2024-06-28",
            "2024-09-30",
            "2024-12-31"
          ],
          "participation_rate": 1.0,
          "past_fixings": [],
          "spot_id": "SPX-SPOT",
          "underlying_ticker": "SPX",
          "vol_surface_id": "SPX-VOL"
        },
        "type": "autocallable"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/autocallable"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "autocallable",
  "type": "object"
}
