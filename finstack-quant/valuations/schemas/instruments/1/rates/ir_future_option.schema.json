{
  "$defs": {
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "IrFutureOption": {
      "additionalProperties": false,
      "description": "Exchange-traded option on an interest rate future (e.g., SOFR futures).\n\nPriced using Black-76 on the futures price. The underlying is the futures\nprice itself (100 - rate), so no convexity adjustment is needed.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "default": {},
          "description": "Attributes for scenario selection and tagging"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for PV calculation"
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Option expiry date"
        },
        "face_value": {
          "default": 1000000.0,
          "description": "Face value of one underlying futures contract (e.g., $1,000,000 for\nSOFR futures). The position size is `notional / face_value` contracts,\nconsistent with [`InterestRateFuture`](crate::instruments::rates::ir_future).",
          "format": "double",
          "type": "number"
        },
        "futures_price": {
          "description": "Underlying futures price (e.g., 95.50 for a 4.50% implied rate)",
          "format": "double",
          "type": "number"
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique identifier"
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Pricing overrides\nInstrument-owned pricing inputs."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Notional amount per contract"
        },
        "option_type": {
          "$ref": "#/$defs/OptionType",
          "description": "Call or Put"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "strike": {
          "description": "Option strike price (in futures price terms, e.g., 95.00)",
          "format": "double",
          "type": "number"
        },
        "tick_size": {
          "description": "Tick size (e.g., 0.0025 for SOFR options)",
          "format": "double",
          "type": "number"
        },
        "tick_value": {
          "description": "Tick value in currency units (e.g., $6.25 for 1M SOFR, $25 for 3M)",
          "format": "double",
          "type": "number"
        },
        "vol_model": {
          "$ref": "#/$defs/SwaptionVolatilityModel",
          "description": "Volatility model the quote refers to. CME SOFR/STIR options are quoted\nin normal (basis-point) vols — use [`VolatilityModel::Normal`] for\nthose. The persisted contract requires this convention explicitly."
        },
        "volatility": {
          "description": "Annualized volatility. Units follow `vol_model`: a decimal lognormal\nvol of the futures price for [`VolatilityModel::Black`] (e.g. `0.006`),\nor a normal vol in **price points** for [`VolatilityModel::Normal`]\n(e.g. `0.60` ≈ 60 bp of annualized rate vol).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "futures_price",
        "strike",
        "expiry",
        "option_type",
        "notional",
        "tick_size",
        "tick_value",
        "volatility",
        "vol_model",
        "discount_curve_id"
      ],
      "type": "object"
    },
    "OptionType": {
      "description": "Option type for pricing",
      "oneOf": [
        {
          "const": "call",
          "description": "Call option",
          "type": "string"
        },
        {
          "const": "put",
          "description": "Put option",
          "type": "string"
        }
      ]
    },
    "SwaptionVolatilityModel": {
      "description": "Volatility model for pricing",
      "oneOf": [
        {
          "const": "black",
          "description": "Black (Lognormal) model (1976)",
          "type": "string"
        },
        {
          "const": "normal",
          "description": "Bachelier (Normal) model",
          "type": "string"
        }
      ]
    },
    "ir_future_option": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/IrFutureOption"
        },
        "type": {
          "const": "ir_future_option",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/rates/ir_future_option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "discount_curve_id": "USD-OIS",
          "expiry": "2025-06-16",
          "face_value": 1000000.0,
          "futures_price": 95.5,
          "id": "IRFO-SOFR-3M-CALL-9550",
          "notional": {
            "amount": "1000000",
            "currency": "USD"
          },
          "option_type": "call",
          "strike": 95.5,
          "tick_size": 0.0025,
          "tick_value": 6.25,
          "vol_model": "normal",
          "volatility": 0.2
        },
        "type": "ir_future_option"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/ir_future_option"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "ir_future_option",
  "type": "object"
}
